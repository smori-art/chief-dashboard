# === BigQuery ===
GCP_PROJECT_ID=your-gcp-project-id
BQ_DATASET_RAW=chief_raw
BQ_DATASET_STG=chief_stg
BQ_DATASET_MART=chief_mart
GCS_BUCKET=chief-dashboard-uploads
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# === Authentication (MVP) ===
AUTH_MODE=simple  # simple | entraid
# Simple auth users (comma-separated user:password:role)
AUTH_USERS=admin:changeme:admin,manager:changeme:manager,viewer:changeme:viewer

# === Entra ID (future) ===
ENTRAID_TENANT_ID=
ENTRAID_CLIENT_ID=
ENTRAID_CLIENT_SECRET=
ENTRAID_REDIRECT_URI=http://localhost:8501/callback

# === Teams ===
TEAMS_MODE=webhook  # webhook | graph
TEAMS_WEBHOOK_URL=https://outlook.office.com/webhook/xxxx
TEAMS_GRAPH_CLIENT_ID=
TEAMS_GRAPH_CLIENT_SECRET=
TEAMS_GRAPH_TENANT_ID=
TEAMS_CHANNEL_ID=

# === App ===
APP_TITLE=Chief Dashboard - Thai Supermarket
APP_TIMEZONE=Asia/Bangkok
DATA_RETENTION_MONTHS=36
LOG_LEVEL=INFO
